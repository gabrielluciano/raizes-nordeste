                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/unidades/{unidadeId}/cardapio": {
      "get": {
        "tags": [
          "Cardápio"
        ],
        "summary": "Obter cardápio da unidade",
        "description": "Lista os pratos ativos e disponíveis da unidade de forma paginada.",
        "operationId": "obterCardapio",
        "parameters": [
          {
            "name": "unidadeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cardápio retornado com sucesso.",
            "content": {
              "*/*": {

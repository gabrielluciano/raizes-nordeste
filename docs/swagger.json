  "paths": {
    "/webhooks/pagamentos/pix": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Confirmar pagamento PIX",
        "description": "Recebe a confirmação de pagamento PIX do gateway. Autenticado pelo header X-Webhook-Secret.",
        "operationId": "confirmarPagamentoPix",
        "parameters": [
          {
            "name": "X-Webhook-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmacaoPixRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Confirmação processada com sucesso."
          },
          "400": {
            "description": "Payload inválido ou header X-Webhook-Secret ausente.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Secret do webhook inválido."
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/pedidos": {
      "get": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Listar pedidos",
        "description": "Lista de forma paginada os pedidos visíveis para a conta autenticada. Clientes veem apenas seus pedidos, funcionários veem os pedidos da própria unidade e administradores veem os pedidos de todas as unidades.",
        "operationId": "listarPedidos",
        "parameters": [
          {
            "name": "canalPedido",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "APP",
                "TOTEM",
                "BALCAO"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pedidos listados com sucesso.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros de consulta inválidos.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pedidos"
        ],
        "summary": "Criar um novo pedido",
        "description": "Cria um novo pedido para a conta autenticada.",
        "operationId": "criar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarPedidoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Pedido criado com sucesso.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CriarPedidoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados do pedido inválidos, prato inativo ou inexistente.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão para criar pedidos.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pagamentos": {
      "post": {
        "tags": [
          "Pagamentos"
        ],
        "summary": "Processar pagamento",
        "description": "Processa um pagamento via cartão ou PIX. Exige o header Idempotency-Key.",
        "operationId": "processarPagamento",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PagamentoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Pagamento com cartão processado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PagamentoSincronoResponse"
                }
              }
            }
          },
          "202": {
            "description": "Pagamento PIX iniciado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PagamentoAssincronoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dados de pagamento inválidos ou header Idempotency-Key ausente.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão para pagar.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },

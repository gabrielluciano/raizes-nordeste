  "components": {
    "schemas": {
      "ConfirmacaoPixRequest": {
        "type": "object",
        "properties": {
          "transacaoId": {
            "type": "string",
            "minLength": 1
          },
          "pagoEm": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "pagoEm",
          "transacaoId"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          }
        }
      },
      "CriarPedidoRequest": {
        "type": "object",
        "properties": {
          "unidadeId": {
            "type": "string"
          },
          "canal": {
            "type": "string",
            "enum": [
              "APP",
              "TOTEM",
              "BALCAO"
            ]
          },
          "nomeCliente": {
            "type": "string"
          },
          "cpfCliente": {
            "type": "string"
          },
          "pickup": {
            "type": "boolean"
          },
          "horarioPedido": {
            "type": "string",
            "format": "date-time"
          },
          "horarioPreparo": {
            "type": "string",
            "format": "date-time"
          },
          "consentimentoFidelizacao": {
            "type": "boolean"
          },
          "pontosDesejados": {
            "type": "integer",
            "format": "int32"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemPedidoRequest"
            },
            "minItems": 1
          }
        },
        "required": [
          "canal",
          "horarioPedido",
          "itens"
        ]
      },
      "ItemPedidoRequest": {
        "type": "object",
        "properties": {
          "pratoId": {
            "type": "string"
          },
          "quantidade": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "pratoId"
        ]
      },
      "CriarPedidoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "PagamentoRequest": {
        "type": "object",
        "properties": {
          "pedidoId": {
            "type": "string",
            "minLength": 1
          },
          "formaPagamento": {
            "type": "string",
            "enum": [
              "PIX",
              "CARTAO_CREDITO",
              "CARTAO_DEBITO"
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "formaPagamento",
          "pedidoId"
        ]
      },
      "PagamentoSincronoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statusPagamento": {
            "type": "string",
            "enum": [
              "PENDENTE",
              "APROVADO",
              "RECUSADO",
              "ERRO"
            ]
          },
          "statusPedido": {
            "type": "string",
            "enum": [
              "PAGAMENTO_PENDENTE",
              "AGUARDANDO_PREPARO",
              "EM_PREPARO",
              "PRONTO",
              "CONCLUIDO",
              "CANCELADO"
            ]
          },
          "motivoRecusa": {
            "type": "string"
          }
        }
      },
      "PagamentoAssincronoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statusPagamento": {
            "type": "string",
            "enum": [
              "PENDENTE",
              "APROVADO",
              "RECUSADO",
              "ERRO"
            ]
          },
          "qrCode": {
            "type": "string"
          },
          "qrCodeValidoAte": {
            "type": "string",
            "format": "date-time"
